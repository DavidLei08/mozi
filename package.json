{
  "name": "mozi",
  "productName": "Mozi",
  "version": "0.4.6",
  "description": "Mozi — a local toolbox for API testing, encoding, JSON, images and Markdown",
  "main": "src/main/main.js",
  "author": {
    "name": "Mozi contributors",
    "email": "44797226+DavidLei08@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.mozi.app",
    "productName": "Mozi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "publish": null,
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "copyright": "Copyright © 2026 Mozi contributors"
  },
  "homepage": "https://github.com/DavidLei08/mozi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidLei08/mozi.git"
  },
  "bugs": {
    "url": "https://github.com/DavidLei08/mozi/issues"
  },
  "keywords": [
    "electron",
    "api-client",
    "postman",
    "curl",
    "json",
    "base64",
    "markdown",
    "jwt",
    "toolbox"
  ]
}
